        "model": {
          "type": "minecraft:model",
          "model": "enhanced:item/iron_man_mark_5_suitcase_icon"
        }
      },
      {
        "when": "fixed",
        "model": {
          "type": "minecraft:model",
          "model": "enhanced:item/iron_man_mark_5_suitcase_icon"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "enhanced:item/iron_man_mark_5_suitcase_3d"
    }
  }
}
